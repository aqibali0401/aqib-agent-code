# ====================================
# AQIB Agent Nest - Environment Configuration
# ====================================
# Last Updated: October 27, 2025

# ====================================
# Application Settings
# ====================================
PORT=5000
APP_VERSION=1.0.0
LOG_LEVEL=info
LOG_RETAIN_PERIOD=7

# Build and Package Configuration
BUILD_OUTPUT_DIR=D:\qsc-3\output

# ====================================
# Edge Assembly Configuration
# ====================================


# Device Identity (must match certificate CN)
# DEVICE_ID=AIO_20VD_PG02W5PL // Set dynamically at runtime 
DEVICE_TYPE=AIO

# ====================================
# X.509 Certificate Authentication
# ====================================
USE_CERTIFICATE_AUTH=true

# //Set dynamically at runtime 

# X509_CERT_FILE=./certificates/device.pem
# X509_KEY_FILE=./certificates/device.key
# X509_PASSPHRASE=

# ====================================
# Device Provisioning Service (DPS)
# ====================================
DPS_TRANSPORT_TYPE=mqtt
# DPS_PROVISIONING_HOST=aio-dps.azure-devices-provisioning.net
DPS_ID_SCOPE=0ne0106AE1F
DPS_SECURITY_TYPE=x509

# ====================================
# MQTT Transport Settings
# ====================================
USE_WEBSOCKETS=true
MQTT_WS_PATH=/mqtt

# ====================================
# Telemetry Settings
# ====================================
TELEMETRY_INTERVAL_MS=14400000

# ====================================
# Legacy Configuration (kept for backward compatibility)
# ====================================
PROVISIONING_HOST=aio-dps.azure-devices-provisioning.net




ENABLE_PERIODIC_TELEMETRY=false


# // after removing old code 
# IMPORTANT: Set to 'true' to use Edge Assembly, 'false' to use legacy IoT service
# USE_EDGE_ASSEMBLY=true
