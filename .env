# Application Settings
# ====================================
PORT=5000
APP_VERSION=1.0.0
LOG_LEVEL=info
LOG_RETAIN_PERIOD=7
LICENSE_KEY=

# Build and Package Configuration
BUILD_OUTPUT_DIR=D:\qsc-3\output



# Device Identity (must match certificate CN)
# DEVICE_ID=AIO_20VD_PG02W5PL // Set dynamically at runtime 
DEVICE_TYPE=AIO

# ====================================
# X.509 Certificate Authentication
# ====================================
USE_CERTIFICATE_AUTH=true
X509_CERT_FILE=./certificates/device.pem
X509_PASSPHRASE=

# // not needed for TPM auth
# X509_KEY_FILE=./certificates/device.key

# TPM-Based Authentication (Recommended for Production)
# When enabled, private key is stored securely in TPM hardware and never exposed as a file
# This is the most secure option and prevents private key exfiltration
USE_TPM_AUTH=true

# ====================================
# Device Provisioning Service (DPS)
# ====================================
DPS_TRANSPORT_TYPE=mqtt
DPS_SECURITY_TYPE=x509
DPS_PROVISIONING_HOST=iot-dps-reflect-hub-wus2-dev.azure-devices-provisioning.net
DPS_ID_SCOPE=0ne00FD6AF7

# ====================================
# MQTT Transport Settings
# ====================================
USE_WEBSOCKETS=true
MQTT_WS_PATH=/mqtt

# ====================================
# Telemetry Settings
# ====================================
TELEMETRY_INTERVAL_MS=14400000

ENABLE_PERIODIC_TELEMETRY=false


 
# /// for udi framework -----

# # Optional: Path to udicli.exe (if not in PATH)
# UDI_CLI_PATH=D:\qsc-3\uid-donloads\QSC Windows Bar API\udicli.exe

# # Optional: UDI API token (if not using udicli.txt)
# UDI_TOKEN=xZLhfGLJQfKGcpdSrLCicw9obxqTJNF9mJOAg60reZCNiGy3

# # Cache
# UDI_CACHE_ENABLED=true
# UDI_CACHE_TTL_MS=3600000
# UDI_CACHE_DIR=./.cache



# # Provisioning automation
DEV_ENROLL_AUTH_TOKEN=dev-provisioning-token

   AUTO_ENROLL_ENABLED=true
   
   ENROLLMENT_URL=http://localhost:4300
   ENROLLMENT_TOKEN=dev-provisioning-token
   # X509_CA_CHAIN_FILE=./certificates/ca-chain.pem
   CSR_OUTPUT_PATH=./certificates/csr-AIO_20VD_PG02W5PL.req
# 'D:\\qsc-3\\mithun-package\\final-agent-nest\\certificates\\csr-AIO_20VD_PG02W5PL.req'